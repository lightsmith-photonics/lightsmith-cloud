# Copy to .env for docker compose. Never commit .env.

# The scientific library, until it is published: a wheel under ./wheels, or a git URL.
#   uv build --wheel <library repo> --out-dir wheels   ->  LIBRARY_SPEC=wheels/lightsmith-0.1.0-py3-none-any.whl
#   LIBRARY_SPEC=lightsmith @ git+https://github.com/lightsmith-photonics/lightsmith@<tag>
LIBRARY_SPEC=

# Random secrets: python -c "import secrets;print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
LIGHTSMITH_API_KEY_PEPPER=
LIGHTSMITH_ADMIN_TOKEN=
# Shared with the platform (apps/web), which signs HS256 JWTs: sub, role, aud=compute, optional org_id/orgs.
PLATFORM_JWT_SECRET=
LIGHTSMITH_JWT_AUDIENCE=compute

# Branding
LIGHTSMITH_HOSTED_PRODUCT_NAME=Lightsmith Cloud

# Stripe TEST mode only (sk_test_/rk_test_). Live keys are refused at start-up.
# `lightsmith-server stripe-setup` creates the objects below and prints their ids (see README).
STRIPE_SECRET_KEY=
# From `stripe listen` (local) or the dashboard's webhook endpoint (deployed).
STRIPE_WEBHOOK_SECRET=
LIGHTSMITH_STRIPE_PRICE_PRO=
LIGHTSMITH_STRIPE_PRICE_TEAM=
LIGHTSMITH_STRIPE_PRICE_OVERAGE_PRO=
LIGHTSMITH_STRIPE_PRICE_OVERAGE_TEAM=
LIGHTSMITH_STRIPE_METER_EVENT_NAME=lightsmith_credits
LIGHTSMITH_STRIPE_PORTAL_CONFIGURATION=
# Usage warnings start at this fraction of a plan's included credits.
LIGHTSMITH_QUOTA_SOFT_LIMIT_FRACTION=0.8
LIGHTSMITH_PUBLIC_WEB_URL=http://localhost:3000

# GPU tiers "queue:GiB:credit_multiplier", smallest first. Workers serve the tiers their GPU fits.
LIGHTSMITH_GPU_TIERS=gpu-12g:12:1.0,gpu-24g:24:1.0,gpu-80g:80:3.0

# Optional S3-compatible result storage (AWS S3, Cloudflare R2, ...). For the local SeaweedFS gateway
# (`docker compose --profile s3 up`), uncomment these; it accepts any credentials (dev only).
# LIGHTSMITH_S3_BUCKET=lightsmith-results
# LIGHTSMITH_S3_ENDPOINT_URL=http://s3:8333
# LIGHTSMITH_S3_CREATE_BUCKET=true
# AWS_ACCESS_KEY_ID=dev
# AWS_SECRET_ACCESS_KEY=dev
# AWS_DEFAULT_REGION=us-east-1

LIGHTSMITH_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,tauri://localhost,http://tauri.localhost
